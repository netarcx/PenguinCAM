# Python
__pycache__/
*.pyc

# Virtual environments (project uses uv/.venv; a stray root venv was cleaned up)
venv/
.venv/
bin/
lib/
lib64/
include/
share/
pyvenv.cfg

# Environment / editor / deploy
.env
.obsidian
.vercel
.DS_Store
.lock

# Credentials / OAuth config (NEVER commit these)
google-creds.txt
staging-oauth
onshape_config.json
*-creds.txt

# Working team configs (keep the committed template, not local overrides)
# Team configs are local machine settings, never committed. A PATTERN, not a literal
# name: teams keep per-machine or per-team variants (PenguinCAM-config-2129.yaml),
# and those were not covered before, so a renamed config could be committed by
# accident along with whatever feeds and machine limits it holds.
PenguinCAM-config.yaml
PenguinCAM-config-*.yaml
PenguinCAM-config.yml
PenguinCAM-config-*.yml

# ...except this one, which is deliberately tracked: it is Team 2129's own machine
# config, holds nothing private (machine specs, feeds, team name), and is useful to
# other FRC teams as a worked example of the v2 schema. The blanket ignore above stays
# so that anyone else's config still cannot be committed by accident.
!PenguinCAM-config-2129.yaml
new-config.yaml

# Generated G-code and DXF debug/test artifacts
*.nc
debug_*.dxf
test_output_*.nc
*-output*.nc

# Backup files
*.bak
*.backup

# ...but never ignore test fixtures/goldens under tests/
!tests/**
